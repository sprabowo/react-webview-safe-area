{
  "name": "react-webview-safe-area",
  "type": "module",
  "version": "0.1.2",
  "description": "Webview safe area helper for React app",
  "author": "Sigit Prabowo",
  "license": "MIT",
  "homepage": "https://github.com/sprabowo/react-webview-safe-area#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprabowo/react-webview-safe-area.git"
  },
  "bugs": {
    "url": "https://github.com/sprabowo/react-webview-safe-area/issues"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./src/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.dts.json",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^11.1.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
